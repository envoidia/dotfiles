{
    "margin-bottom": -20,
    "spacing" : 0,

    "modules-left": [
        "hyprland/workspaces",
        "hyprland/window"
    ],

    "modules-center": [
        "custom/recording"
    ],

    "modules-right": [
      "clock",
      "pulseaudio",
      "battery",
      "custom/brightness",
      "cpu",
      "custom/gpu",
      "memory"
    ],

    "hyprland/workspaces": {
        "format": "{name}"
    },

    "clock": {
        "format": "{:%H:%M %d/%m}"
    },

    "pulseaudio": {
        "format": "{icon}  {volume}%",
        "format-muted": "",
        "format-icons": {
            "default": ["", "", " "]
        },
        "on-click": "pavucontrol"
    },

    "battery": {
        "bat": "BAT0",
        "interval": 60,
        "states": {
            "warning": 20,
            "critical": 10
        },
        "events": {
            "on-discharging-warning": "notify-send -u normal 'Low Battery'",
            "on-discharging-critical": "notify-send -u critical 'Very Low Battery'",
            "on-charging-100": "notify-send -u normal 'Battery Full!'"
        },
        "format": "{icon} {capacity}%",
        "format-icons": ["", "", "", "", ""],
        "max-length": 25
    },

    "custom/brightness": {
        "exec": "brightnessctl get | awk -v max=937 '{printf \"%.0f\", ($1 / max) * 100}'",
        "interval": 1,
        "format": "☀️ {}%",
        "on-click": "brightnessctl set +10%"

    },

    "cpu": {
        "interval": 30,
        "format": " {usage:>2}%",
        "on-click": "kitty --class htop -e htop"
    },

    "memory": {
        "interval": 30,
        "format": "  {used:0.1f}GB",
        "on-click": "kitty --class htop -e htop"
    },

    "custom/gpu": {
        "interval": 30,
        "format": "󰾲 {}",
        "exec": "~/.config/waybar/gpu_usage.sh",
        "on-click": "kitty --class nvidia-smi -e nvidia-smi -l 5"
    },

    "custom/recording": {
        "exec-if": "pgrep -f gpu-screen-recorder",
        "exec": "~/.config/waybar/recording_indicator.sh",
        "on-click": "pkill -f gpu-screen-recorder",
        "return-type": "json",
        "interval": 1,
        "format": "{}"
    }

}

{
    "margin-bottom": -20,
    "spacing": 0,

    "modules-left": ["custom/arch", "hyprland/workspaces", "hyprland/window"],

    "modules-center": ["custom/recording"],

    "modules-right": ["clock", "pulseaudio", "cpu", "custom/cpu-temp", "memory", "custom/gpu"],

    "custom/arch": {
        "format": "󰣇",
    },

    "hyprland/workspaces": {
        "format": "{name}",
    },

    "clock": {
        "format": "{:%H:%M %d/%m}",
        "tooltip-format": "{:%H:%M %a %d/%m/%y}",
    },

    "pulseaudio": {
        "format": "{icon}  {volume}%",
        "format-muted": "",
        "format-icons": {
            "default": ["", "", " "],
        },
        "on-click": "pavucontrol",
    },

    "cpu": {
        "interval": 30,
        "format": " {usage:>2}%",
        "on-click": "kitty --class btop -e btop",
    },

    "custom/cpu-temp": {
        "interval": 30,
        "exec": "awk '{printf \"%.0f°C\\n\", $1/1000}' /sys/class/hwmon/hwmon1/temp2_input",
        "format": "- {}",
        "on-click": "kitty --class btop -e btop",
    },

    "memory": {
        "interval": 30,
        "format": "  {used:0.1f}GB",
        "on-click": "kitty --class btop -e btop",
    },

    "custom/gpu": {
        "interval": 30,
        "format": "󰾲 {}",
        "exec": "echo $(nvidia-smi --query-gpu=utilization.gpu --format=csv,noheader,nounits)% - $(nvidia-smi --query-gpu=temperature.gpu --format=csv,noheader,nounits)°C - $(nvidia-smi --query-gpu=memory.used --format=csv,noheader,nounits 2>/dev/null | awk '{printf \"%.2f\", $1/1024}')GB",
        "on-click": "kitty --class nvtop -e nvtop",
    },

    "custom/recording": {
        "exec-if": "pidof gpu-screen-recorder > /dev/null",
        "exec": "echo '{\"text\": \"  REC\"}'",
        "on-click": "~/.config/record.fish",
        "return-type": "json",
        "interval": 1,
        "format": "{}",
    },
}

{
    "margin-bottom": -20,
    "spacing" : 0,

    "modules-left": [
        "custom/arch",
        "hyprland/workspaces",
        "hyprland/window"
    ],

    "modules-center": [
        "custom/recording"
    ],

    "modules-right": [
      "clock",
      "pulseaudio",
      "cpu",
      "custom/gpu",
      "memory"
    ],

    "custom/arch": {
        "format": "󰣇"
    },

    "hyprland/workspaces": {
        "format": "{name}"
    },

    "clock": {
        "format": "{:%H:%M %d/%m}",
        "tooltip-format": "{:%H:%M %a %d/%m/%y}"
    },

    "pulseaudio": {
        "format": "{icon}  {volume}%",
        "format-muted": "",
        "format-icons": {
            "default": ["", "", " "]
        },
        "on-click": "pavucontrol"
    },

    "cpu": {
        "interval": 30,
        "format": " {usage:>2}%",
        "on-click": "kitty --class htop -e htop"
    },

    "memory": {
        "interval": 30,
        "format": "  {used:0.1f}GB",
        "on-click": "kitty --class htop -e htop"
    },

    "custom/gpu": {
        "interval": 30,
        "format": "󰾲 {}",
        "exec": "~/.config/waybar/gpu_usage.sh",
        "on-click": "kitty --class nvidia-smi -e nvidia-smi -l 5"
    },

    "custom/recording": {
        "exec-if": "pgrep -f gpu-screen-recorder",
        "exec": "~/.config/waybar/recording_indicator.sh",
        "on-click": "pkill -f gpu-screen-recorder",
        "return-type": "json",
        "interval": 1,
        "format": "{}"
    }

}

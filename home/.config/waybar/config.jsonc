{
    "margin-bottom": -20,
    "spacing" : 0,

    "modules-left": [
        "hyprland/workspaces"
    ],

    "modules-right": [
      "clock",
      "pulseaudio",
      "cpu",
      "memory"
    ],

    "hyprland/workspaces": {
        "format": "{name}"
    },

    "clock": {
        "format": "{:%H:%M %d/%m}"
    },

    "pulseaudio": {
        "format": "{icon}  {volume}%",
        "format-muted": "",
        "format-icons": {
            "default": ["", "", " "]
        },
        "on-click": "pavucontrol"
    },

    "cpu": {
        "interval": 30,
        "format": " {usage:>2}%"
    },

    "memory": {
        "interval": 30,
        "format": "  {used:0.1f}GB",
        "tooltip-format": "Memory"
    }

}

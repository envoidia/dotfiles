dstl:
    # Display mode
    dmenu = false
    startup_mode = "dual"
    search_position = "top"
    focus_search_on_switch = true
    
    # Terminal emulator for terminal apps
    terminal = "kitty"
    
    # Recent apps settings
    max_recent_apps = 15
    recent_first = false
    
    # Theme configuration
    theme:
        border = "#73bed3"
        focus = "#a673d3"
        highlight = "#a673d3"
        cursor_shape = "pipe"
        cursor_blink_interval = 500  # milliseconds, 0 to disable
        border_style = "plain"
        highlight_type = "background"  # or "foreground"
    end
end